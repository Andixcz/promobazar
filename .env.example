# Zkopíruj do `.env.local` pro lokální vývoj.
# Na Vercelu nastav stejné klíče v Project → Settings → Environment Variables.
# Nikdy necommituj `.env`, `.env.local` ani reálné secrety.

# =============================================================================
# Aplikace
# =============================================================================

# Veřejná URL webu (OAuth redirecty, e-maily, Stripe success/cancel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# PostgreSQL — Neon + Drizzle ORM + Better Auth
# =============================================================================
# Neon Console → tvůj projekt → Connect → zkopíruj connection string.
#   • Next.js / `bun dev`: **Pooled** (host obsahuje `-pooler`)
#   • `bun run db:push` / `db:migrate` / `db:generate`: ideálně **Direct** (viz DATABASE_URL_MIGRATE)
# Drizzle: https://neon.com/docs/guides/drizzle

DATABASE_URL=postgresql://neondb_owner:********@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Volitelně: přímé připojení jen pro drizzle-kit (push / migrate)
# DATABASE_URL_MIGRATE=postgresql://neondb_owner:********@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Alias (Vercel Postgres integrace někdy nastaví POSTGRES_URL)
# POSTGRES_URL=

# =============================================================================
# Better Auth (https://www.better-auth.com)
# =============================================================================

# Min. 32 znaků — vygeneruj např.: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-long-random-secret

# Kanonická URL aplikace (v produkci https://promobazar.cz)
BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# OAuth providery (Better Auth — social login)
# =============================================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Zobrazí OAuth tlačítka na /prihlaseni a /registrace (server musí mít odpovídající *_CLIENT_*)
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
NEXT_PUBLIC_DISCORD_OAUTH_ENABLED=false

# =============================================================================
# Propojení platforem v dashboardu (OAuth tvůrce — ne přihlášení do účtu)
# =============================================================================
# Redirect URL nastav u providera na:
#   {NEXT_PUBLIC_APP_URL}/api/platform/callback/twitch|kick|tiktok|youtube|instagram
# Server-side creds: lib/dashboard/platform-linking-env.ts

# Twitch — https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kick — https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# TikTok — https://developers.tiktok.com (clientKey, ne clientId)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube — Google Cloud OAuth (YouTube Data API v3). Může být stejný klient jako GOOGLE_* níže.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Meta / Instagram — developers.facebook.com (Instagram API ve stejné Meta aplikaci)
META_APP_ID=
META_APP_SECRET=

# =============================================================================
# Stripe (Checkout, předplatné Growth / Creator PRO, webhooky)
# =============================================================================

# Secret key — pouze server (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...

# Publishable key — může jít do klienta (Payment Element / Stripe.js)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret (Dashboard → Developers → Webhooks → endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ID z Stripe Dashboard (Products → ceník)
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_CREATOR_PRO=price_...

# Volitelné: Stripe Connect pro výplaty tvůrcům / escrow flow
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_CLIENT_ID=ca_...

# --- (1) Klient: Supabase JS (legacy demo v public/app.js) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Nový název v dashboardu; starší projekty používají ANON_KEY (stejná role)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role — jen server-side, nikdy do prohlížeče (není náhrada za DATABASE_URL)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# =============================================================================
# Volitelné
# =============================================================================

# E-mail (OTP / magic link přes Better Auth nebo vlastní provider)
# RESEND_API_KEY=re_...
# EMAIL_FROM=podpora@promobazar.cz

# Sentry, analytics, …
# SENTRY_DSN=
